<?xml version="1.0" encoding="utf-8"?>
<!-- A padlock whose body is a drive: shackle, rounded body, keyhole, and a drive's activity light. Safe zone 21..87. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 0.66 about the centre, as the home-page padlock, so the body clears the circular mask; translateY centres the
         shut padlock (shackle top 28 … body bottom 83, middle 55.5) on the circle: -1.5 units × 0.66 -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.66" android:scaleY="0.66" android:translateY="-0.99">
    <!-- shackle -->
    <path
        android:pathData="M42,51 V43 a12,12 0 0 1 24,0 V51"
        android:strokeColor="#B5ABFC"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- body -->
    <path android:pathData="M37,49 h34 a7,7 0 0 1 7,7 v20 a7,7 0 0 1 -7,7 h-34 a7,7 0 0 1 -7,-7 v-20 a7,7 0 0 1 7,-7 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="49"
                android:endX="78" android:endY="83"
                android:startColor="#B5ABFC"
                android:endColor="#796CBF" />
        </aapt:attr>
    </path>
    <!-- keyhole -->
    <path
        android:pathData="M54,58 a4.5,4.5 0 0 1 2.4,8.3 l1.1,7.2 h-7 l1.1,-7.2 A4.5,4.5 0 0 1 54,58 z"
        android:fillColor="#161826" />
    <!-- drive activity light -->
    <path
        android:pathData="M70,77 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"
        android:fillColor="#7BC8A4" />
    </group>
</vector>
